# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>

pkgname=where-git
pkgver=1.3.0.r0.g8e071fe
pkgrel=1
pkgdesc="A fast replacement for the which and where commands on Linux. (Git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/revanthnemtoor/where"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('git' 'cargo')
provides=('where' 'where-cmd')
conflicts=('where' 'where-cmd')
source=('git+https://github.com/revanthnemtoor/where.git')
sha256sums=('SKIP')
options=(!lto)

pkgver() {
  cd where
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g' | sed 's/^v//'
}

build() {
  cd where
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release
}

check() {
  cd where
  cargo test --release
}

package() {
  cd where
  install -Dm755 "target/release/where" "$pkgdir/usr/bin/where"
  install -Dm644 "docs/where.1" "$pkgdir/usr/share/man/man1/where.1"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Install shell integration scripts
  install -Dm644 "shell/where.bash" "$pkgdir/etc/profile.d/where.sh"
  install -Dm644 "shell/where.fish" "$pkgdir/usr/share/fish/vendor_conf.d/where.fish"
  install -Dm644 "shell/where.zsh" "$pkgdir/usr/share/where/where.zsh"
}
