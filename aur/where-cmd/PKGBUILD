# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>

pkgname=where-cmd
pkgver=1.2.11
pkgrel=1
pkgdesc="A fast replacement for the which and where commands on Linux."
arch=('x86_64' 'aarch64')
url="https://github.com/revanthnemtoor/where"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
provides=('where')
conflicts=('where')
source=("$pkgname-$pkgver.tar.gz::https://github.com/revanthnemtoor/where/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('195a8e9ce590796dfe27d0c09e27959c2f89086fcc56cc7cc161c6fe07f979cf')
options=(!lto)

build() {
  cd "where-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --locked --release
}

check() {
  cd "where-$pkgver"
  cargo test --locked --release
}

package() {
  cd "where-$pkgver"
  install -Dm755 "target/release/where" "$pkgdir/usr/bin/where"
  install -Dm644 "docs/where.1" "$pkgdir/usr/share/man/man1/where.1"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  
  # Install shell integration scripts
  install -Dm644 "shell/where.bash" "$pkgdir/etc/profile.d/where.sh"
  install -Dm644 "shell/where.fish" "$pkgdir/usr/share/fish/vendor_conf.d/where.fish"
  install -Dm644 "shell/where.zsh" "$pkgdir/usr/share/where/where.zsh"
}
